{
    "name": "brunoscode/laravel-ts-annotations",
    "description": "Write raw TypeScript types in PHP attributes and generate .ts files with an Artisan command.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Bruno Magnani",
            "email": "bruno@brunoscode.eu"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Brunoscode\\LaravelTsAnnotations\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Brunoscode\\LaravelTsAnnotations\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Brunoscode\\LaravelTsAnnotations\\TsAnnotationsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
